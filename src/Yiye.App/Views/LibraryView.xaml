<UserControl x:Class="Yiye.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shelf="clr-namespace:Yiye.Controls"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="MonthButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Height" Value="220" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryWorkItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Height" Value="200" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="WorkSurface" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="WorkSurface" Property="Background" Value="{StaticResource SurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="WorkSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="WorkSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="LibraryPane" Background="{StaticResource PageBrush}">
        <Grid Margin="28,16,28,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12" MinHeight="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="作品库" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="LibraryCountText" Grid.Column="1" Text="0 部作品" Foreground="{StaticResource MutedBrush}"
                           FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Width="1" Height="18" Margin="20,0" Background="{StaticResource DividerBrush}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AllFilterButton" Content="全部" Tag="all" Click="Filter_Click" Selector.IsSelected="True" Style="{StaticResource FilterButton}" />
                    <Button x:Name="BookFilterButton" Content="书籍" Tag="book" Click="Filter_Click" Margin="4,0" Style="{StaticResource FilterButton}" />
                    <Button x:Name="ScreenFilterButton" Content="影视" Tag="screen" Click="Filter_Click" Style="{StaticResource FilterButton}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CoverViewButton" Content="封面" Tag="covers" Click="ViewMode_Click" Selector.IsSelected="True"
                            Style="{StaticResource FilterButton}" ToolTip="按类别展示作品封面" AutomationProperties.Name="封面视图" />
                    <Button x:Name="MonthViewButton" Content="月份" Tag="months" Click="ViewMode_Click" Margin="4,0,0,0"
                            Style="{StaticResource FilterButton}" ToolTip="按最近记录月份分组" AutomationProperties.Name="月份视图" />
                </StackPanel>
            </Grid>
            <Grid x:Name="RegularWorksHeader" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="MonthBackButton" Content="返回月份" Click="CloseLibraryMonth_Click" Style="{StaticResource TextButton}"
                        Visibility="Collapsed" Margin="-12,0,12,0" />
                <TextBlock x:Name="LibraryMonthHeading" Grid.Column="1" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource MutedStrongBrush}" />
            </Grid>
            <Grid x:Name="PageViewport" Grid.Row="2" SizeChanged="PageViewport_SizeChanged" ClipToBounds="True">
                <Border x:Name="EmptyState" Style="{StaticResource ReadingPanel}" Padding="24">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <md:PackIcon Kind="BookOutline" Width="40" Height="40" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20" />
                        <TextBlock x:Name="EmptyTitle" Text="还没有作品" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyDescription" Text="添加一本书或一部影视。" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,12,0,24" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Content="添加作品" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="AddWork_Click" />
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="MonthOverview" Visibility="Collapsed" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="MonthList" ItemsSource="{Binding PageMonths}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><shelf:LibraryShelfPanel MinimumTileWidth="220" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="MonthDeckButton" Margin="0,0,12,12" Tag="{Binding}" Click="OpenLibraryMonth_Click"
                                        Style="{StaticResource MonthButtonStyle}" ToolTip="{Binding OpenLabel}" AutomationProperties.Name="{Binding OpenLabel}">
                                    <StackPanel>
                                        <Grid Height="46" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CountLabel}" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                            <md:PackIcon Grid.Column="1" Kind="ChevronRight" Width="20" Height="20" Margin="8,0,0,0"
                                                         VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        </Grid>
                                        <Viewbox Height="138" Stretch="Uniform" IsHitTestVisible="False">
                                            <ItemsControl ItemsSource="{Binding PreviewCards}" Width="220" Height="232">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                        <Setter Property="Panel.ZIndex" Value="{Binding Layer}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="126" Height="182" Padding="2" Background="{StaticResource SurfaceBrush}"
                                                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.8">
                                                            <Border.RenderTransform><RotateTransform Angle="{Binding Angle}" /></Border.RenderTransform>
                                                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.15" Color="#333333" /></Border.Effect>
                                                            <Grid>
                                                                <StackPanel VerticalAlignment="Center" Margin="10">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=MonthCover}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="{Binding Work.KindGlyph}" FontSize="28" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Work.Title}" FontSize="15" TextAlignment="Center" Margin="0,12,0,0"
                                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" />
                                                                </StackPanel>
                                                                <Image x:Name="MonthCover" Source="{Binding Work.PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=400}" Stretch="Uniform" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ListBox x:Name="WorkList" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0"
                         SelectionChanged="WorkList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False"
                         ItemContainerStyle="{StaticResource LibraryWorkItem}">
                    <!-- GroupStyle.Panel lays out groups; ItemsPanel lays out the works inside each group. -->
                    <ListBox.ItemsPanel><ItemsPanelTemplate><shelf:LibraryShelfPanel MinimumTileWidth="118" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.GroupStyle>
                        <GroupStyle HidesIfEmpty="True">
                            <GroupStyle.Panel><ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate></GroupStyle.Panel>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Border x:Name="ShelfGroupPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="20" Padding="12,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                        <StackPanel Orientation="Horizontal" Height="24" Margin="3,0,0,8">
                                                            <TextBlock x:Name="ShelfGroupHeading" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ItemCount, StringFormat='本页 {0} 部'}" FontSize="13"
                                                                       Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <ItemsPresenter Grid.Row="1" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate><StaticResource ResourceKey="ShelfWorkTemplate" /></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid x:Name="LibraryPager" Grid.Row="3" Margin="0,8,0,0" Height="34" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="PageSummaryText" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PreviousPageButton" Content="上一页" Click="PreviousPage_Click" Style="{StaticResource TextButton}" />
                    <TextBlock x:Name="PageIndicatorText" MinWidth="56" TextAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                    <Button x:Name="NextPageButton" Content="下一页" Click="NextPage_Click" Style="{StaticResource TextButton}" />
                </StackPanel>
            </Grid>
            <TextBox x:Name="SearchBox" Visibility="Collapsed" TextChanged="SearchBox_TextChanged" />
            <Button x:Name="LibraryAddWorkButton" Visibility="Collapsed" Content="添加作品" Click="AddWork_Click" Style="{StaticResource HeaderAddWorkButton}" />
        </Grid>
        <Canvas x:Name="MonthTransitionLayer" IsHitTestVisible="False" Panel.ZIndex="10" ClipToBounds="True" />
    </Grid>
</UserControl>
