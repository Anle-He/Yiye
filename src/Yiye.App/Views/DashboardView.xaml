<UserControl x:Class="Yiye.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:Yiye.Models" xmlns:behaviors="clr-namespace:Yiye.Behaviors" xmlns:shelf="clr-namespace:Yiye.Controls" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
<UserControl.Resources>        <DataTemplate x:Key="ShowcaseRankItemTemplate">
            <Button Tag="{Binding}" Click="DashboardWork_Open" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" ToolTip="{Binding Title}">
                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,10,12,0"/><TextBlock Grid.Column="1" Text="{Binding RankLabel}" Style="{StaticResource DashboardScore}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="FeaturedWorkTemplate">
            <Grid Margin="0,4,16,4"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Tag="{Binding}" Click="DashboardWork_Open" Padding="0" BorderThickness="0" Background="Transparent" ToolTip="打开作品" HorizontalAlignment="Left">
                    <Border Width="112" Height="164" Background="{StaticResource AccentSoftBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-3"/></Border.RenderTransform><Grid><TextBlock Text="{Binding KindGlyph}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=300}" Stretch="Uniform"/></Grid></Border>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="最近完成" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Title}" FontFamily="SimSun" FontSize="28" TextWrapping="Wrap" Margin="0,12,0,8"/><TextBlock Text="{Binding Author}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding LatestDateLabel, StringFormat=完成于 {0}}" Margin="0,20,0,8" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding RankLabel}" Style="{StaticResource DashboardScore}" FontSize="32"/></StackPanel>
            </Grid>
        </DataTemplate>
</UserControl.Resources>
<Grid Margin="0,10,10,10" Background="{StaticResource DetailPaneBrush}">
                <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,16,24,12">
                        <Grid x:Name="DashboardCollectionHeader" Margin="0,0,0,4" Visibility="Collapsed"><TextBlock Text="我的收藏" FontFamily="SimSun" FontSize="30"/><ui:Button x:Name="DashboardAddWorkButton" Content="收录作品" Icon="{ui:SymbolIcon Add24}" Style="{StaticResource HeaderAddWorkButton}" Click="AddWork_Click"/></Grid>
                        <Border x:Name="DashboardHero" Height="302" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="#D8E0D9" BorderThickness="1" CornerRadius="26" ClipToBounds="True"
                                Effect="{StaticResource HeroShadow}">
                            <Grid>
                                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                    <Ellipse Width="430" Height="430" Canvas.Left="570" Canvas.Top="-104" Fill="#CFE2D6" />
                                    <Ellipse Width="244" Height="244" Canvas.Left="700" Canvas.Top="18" Fill="#F2DFC4" Stroke="#D7B97E" StrokeThickness="1" />
                                    <Ellipse Width="112" Height="112" Canvas.Left="638" Canvas.Top="138" Fill="#E4B75F" Opacity="0.82" />
                                    <Path Data="M 500,270 C 650,132 805,84 1010,110" Stroke="#7DA48D" StrokeThickness="1.4" />
                                    <Path Data="M 590,286 C 720,190 846,166 1015,183" Stroke="#B17A31" StrokeThickness="1.2" StrokeDashArray="3,8" />
                                    <Ellipse Width="8" Height="8" Canvas.Left="595" Canvas.Top="58" Fill="#B15F48" />
                                </Canvas>

                                <Grid x:Name="DashboardHeroEmptyContent" Margin="32,26">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="私人书影音档案" Style="{StaticResource SectionEyebrow}" />
                                        <TextBlock Text="把完成的作品留在这里" Margin="0,14,0,0" FontSize="36" FontWeight="SemiBold" />
                                        <TextBlock Text="书、影视和感受，会在这里慢慢形成你的私人档案。" Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                                        <ui:Button Content="收录作品" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="0,22,0,0" HorizontalAlignment="Left" Padding="17,8" Click="AddWork_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0" Padding="0,10,0,14" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,28,0"><TextBlock x:Name="DashboardWorkCountText" Text="0" FontFamily="Georgia" FontSize="22" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="部收藏" Margin="7,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,28,0"><TextBlock x:Name="DashboardActiveCountText" Text="0" FontFamily="Georgia" FontSize="22" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="次评分" Margin="7,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="DashboardExperienceCountText" Text="0" FontFamily="Georgia" FontSize="22" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="次完成" Margin="7,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                            </WrapPanel>
                        </Border>

                        <StackPanel x:Name="DashboardShowcasePanel" Margin="0,16,0,0">
                            <Grid x:Name="DashboardColumns" SizeChanged="DashboardColumns_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
                                <Grid x:Name="DashboardMainColumn">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border x:Name="DashboardRecentSection" Background="#F0EADF" CornerRadius="8" Padding="24,16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ContentControl Content="{Binding SelectedItem, ElementName=RecentWorkPicker}" ContentTemplate="{StaticResource FeaturedWorkTemplate}" HorizontalContentAlignment="Stretch"/>
        <ListBox x:Name="RecentWorkPicker" Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding DashboardRecentWorks}" SelectedIndex="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" Background="Transparent" Padding="12,10" BorderBrush="Transparent" BorderThickness="2,0,0,0"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter TargetName="Selection" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=80}" Width="36" Height="50" Stretch="Uniform"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding LatestDateLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Border>
                                </Grid>
                                <Grid x:Name="DashboardSideColumn" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border x:Name="DashboardBookRanking" Background="{StaticResource SurfaceBrush}" CornerRadius="6"><Border Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Book24" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="书籍评分榜" Style="{StaticResource ShowcaseHeading}"/></StackPanel></Grid>
                                        <ItemsControl AlternationCount="3" ItemsSource="{Binding DashboardTopBooks}" ItemTemplate="{StaticResource ShowcaseRankItemTemplate}"/>
                                        <TextBlock Text="还没有完整评分的书籍" Margin="4,10" Foreground="{StaticResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardTopBooks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </StackPanel>
                                </Border></Border>
<Border x:Name="DashboardScreenRanking" Grid.Column="1" Margin="24,0,0,0" Background="{StaticResource SurfaceBrush}" CornerRadius="6"><Border Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="16" Foreground="{StaticResource WarmBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="影视评分榜" Style="{StaticResource ShowcaseHeading}"/></StackPanel></Grid>
                                        <ItemsControl AlternationCount="3" ItemsSource="{Binding DashboardTopScreens}" ItemTemplate="{StaticResource ShowcaseRankItemTemplate}"/>
                                        <TextBlock Text="还没有完整评分的影视" Margin="4,10" Foreground="{StaticResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardTopScreens.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </StackPanel>
                                </Border></Border>
<Border x:Name="DashboardAuthorRanking" Grid.Column="2" Margin="24,0,0,0" Background="{StaticResource SurfaceBrush}" CornerRadius="6"><Border Padding="14,12">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ui:SymbolIcon Symbol="PersonStar24" FontSize="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="作者评分榜" Style="{StaticResource ShowcaseHeading}"/></StackPanel>
                                    <ItemsControl Grid.Row="1" Margin="0,6,0,0" ItemsSource="{Binding DashboardTopAuthors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0" Padding="0,6" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PositionLabel}" FontSize="16" FontFamily="Georgia" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Author}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding WeightedRankLabel}" Style="{StaticResource DashboardScore}" ToolTip="{Binding EvidenceLabel}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <TextBlock Grid.Row="1" Margin="2,14,0,0" Text="暂无作者评分" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardTopAuthors.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Grid>
                            </Border></Border>

                                </Grid>
<Border x:Name="DashboardJournalSection" Grid.Column="2" Padding="0" Background="Transparent">
                        <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="最近记录" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>

                        </Grid>
                        <Border x:Name="DashboardEmptyState" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="14" Padding="30" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center"><TextBlock Text="收藏从第一部作品开始" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="添加一本书或一部影视，它会出现在这里。" Margin="0,7,0,16" Foreground="{StaticResource MutedBrush}" /><ui:Button Content="添加作品" Appearance="Primary" Click="AddWork_Click" HorizontalAlignment="Center" /></StackPanel>
                        </Border>
                        <Border x:Name="DashboardTimelineEmptyState" Padding="22,18" Background="#F5F7F4" CornerRadius="18,6,18,6" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="{StaticResource AccentSoftBrush}" CornerRadius="20">
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="13,1,0,0">
                                    <TextBlock Text="第一条轨迹，从一次记录开始" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="完成一本书或一部影视后，它会留在这里。" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="DashboardTimelineList" ItemsSource="{Binding DashboardTimelineDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="270" Margin="0,0,16,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding DateLabel}" FontFamily="Georgia" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="{Binding YearLabel}" Margin="0,4,0,0" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource TimelineBrush}"/>
                                        <Ellipse Grid.Column="1" Width="5" Height="5" Margin="0,14,0,0" VerticalAlignment="Top" Fill="{StaticResource AccentBrush}"/>
                                        <ItemsControl Grid.Column="2" Margin="6,0,0,8" ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}" Click="DashboardWork_Open" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" AutomationProperties.Name="{Binding Title}">
                                                        <Button.Template><ControlTemplate TargetType="Button">
                                                            <Border x:Name="Surface" Padding="5,6" CornerRadius="6" Background="Transparent"><ContentPresenter/></Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentSoftBrush}"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate></Button.Template>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ActionLabel}" Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                                                <TextBlock x:Name="TimelineNote" Text="{Binding NotesExcerpt}" Margin="0,5,0,0" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <DataTemplate.Triggers><DataTrigger Binding="{Binding HasNotes}" Value="False"><Setter TargetName="TimelineNote" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                        </Border>

                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

</Grid>
</UserControl>
