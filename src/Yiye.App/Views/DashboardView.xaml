<UserControl x:Class="Yiye.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:shelf="clr-namespace:Yiye.Controls" SizeChanged="Dashboard_SizeChanged">
 <UserControl.Resources>
  <Style x:Key="DashboardRowButton" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DashboardSectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
  <Style x:Key="DashboardEmptyLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,10,0,8"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Style>
  <DataTemplate x:Key="RecentCoverTemplate">
   <Button x:Name="RecentAction" Tag="{Binding}" Click="DashboardWork_Open" Style="{StaticResource DashboardRowButton}" Margin="0,0,10,8" Padding="8" Background="{StaticResource SurfaceSecondaryBrush}" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid x:Name="RecentThumbnail" Width="60" Height="84" Margin="0,0,12,0">
      <TextBlock Text="{Binding KindGlyph}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
      <Image Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=240}" Stretch="Uniform"/>
     </Grid>
     <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Row="1" Text="{Binding Author}" FontSize="13" Height="18" LineHeight="18" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
      <Grid Grid.Row="2" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LatestDateLabel}" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/><TextBlock Grid.Column="1" Text="{Binding RankLabel}" FontSize="15" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Grid>
     </Grid>
    </Grid>
   </Button>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Compact"><Setter TargetName="RecentThumbnail" Property="Width" Value="42"/><Setter TargetName="RecentThumbnail" Property="Height" Value="60"/><Setter TargetName="RecentThumbnail" Property="Margin" Value="0,0,8,0"/><Setter TargetName="RecentAction" Property="Padding" Value="4"/><Setter TargetName="RecentAction" Property="Margin" Value="0,0,8,4"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="ShowcaseRankItemTemplate">
   <Button Tag="{Binding}" Click="DashboardWork_Open" Style="{StaticResource DashboardRowButton}" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}" Margin="0,0,10,4" Padding="0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Width="32" Height="46" HorizontalAlignment="Left"><TextBlock Text="{Binding KindGlyph}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><Image Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=120}" Stretch="Uniform"/></Grid>
     <Grid Grid.Column="1" VerticalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="20"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="15" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="RankAuthor" Text="{Binding Author}" ToolTip="{Binding Author}" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding RankLabel}" FontSize="15" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/></Grid>
     </Grid>
    </Grid>
   </Button>
  </DataTemplate>
 </UserControl.Resources>
 <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource PageBrush}">
  <StackPanel x:Name="DashboardContent" Margin="24,8,24,16">
   <Border x:Name="DashboardHero" Style="{StaticResource ReadingPanel}" Padding="32,48">
    <StackPanel><md:PackIcon Kind="BookOpenPageVariantOutline" Width="40" Height="40" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="添加第一部作品" FontSize="24" FontWeight="SemiBold" Margin="0,24,0,0"/><TextBlock Text="记录读过的书、看过的影视，以及自己的评分和感想。" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><Button Content="添加作品" Style="{StaticResource PrimaryButton}" Click="AddWork_Click" HorizontalAlignment="Left" Margin="0,24,0,0"/></StackPanel>
   </Border>
   <Grid x:Name="DashboardCollectionHeader" Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="我的书影音" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="DashboardAddWorkButton" Content="添加作品" Click="AddWork_Click" Visibility="Collapsed"/>
    <Border x:Name="DashboardStats" Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
     <TextBlock x:Name="DashboardWorkCountText" Text="0" FontSize="13" Foreground="{StaticResource MutedBrush}"/><TextBlock Text=" 部作品" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,18,0"/>
     <TextBlock x:Name="DashboardActiveCountText" Text="0" FontSize="13" Foreground="{StaticResource MutedBrush}"/><TextBlock Text=" 次评分" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,18,0"/>
     <TextBlock x:Name="DashboardExperienceCountText" Text="0" FontSize="13" Foreground="{StaticResource MutedBrush}"/><TextBlock Text=" 次完成" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel></Border>
   </Grid>
   <StackPanel x:Name="DashboardShowcasePanel">
    <Grid x:Name="DashboardMainColumn">
     <Border x:Name="DashboardRecentSection" Style="{StaticResource ReadingPanel}" Padding="16,14,6,8"><StackPanel>
      <TextBlock Text="最近完成" Style="{StaticResource DashboardSectionHeading}" Margin="0,0,0,8"/>
      <TextBlock Text="还没有完成记录。打开作品，记下读完或看完的日期。" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardRecentWorks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <ItemsControl x:Name="RecentWorkPicker" ItemsSource="{Binding DashboardRecentWorks}" ItemTemplate="{StaticResource RecentCoverTemplate}" AutomationProperties.Name="最近完成的作品"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
     </StackPanel></Border>
    </Grid>
    <Grid x:Name="DashboardColumns" Margin="0,12,0,0" SizeChanged="DashboardColumns_SizeChanged">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
     <Border x:Name="DashboardSideColumn" Style="{StaticResource ReadingPanel}" Padding="16"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="DashboardBookRanking"><StackPanel>
       <StackPanel x:Name="BookHeadingPanel" Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="书籍评分" Style="{StaticResource DashboardSectionHeading}"/><TextBlock Text="满分 3.9" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="12,4,0,0"/></StackPanel>
       <ItemsControl ItemsSource="{Binding DashboardTopBooks}" ItemTemplate="{StaticResource ShowcaseRankItemTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
       <TextBlock Text="暂无已评分的书籍"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DashboardEmptyLabel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardTopBooks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel></Border>
      <Border x:Name="DashboardScreenRanking" Grid.Row="1" Margin="0,12,0,0"><StackPanel>
       <StackPanel x:Name="ScreenHeadingPanel" Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="影视评分" Style="{StaticResource DashboardSectionHeading}"/><TextBlock Text="满分 3.9" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="12,4,0,0"/></StackPanel>
       <ItemsControl ItemsSource="{Binding DashboardTopScreens}" ItemTemplate="{StaticResource ShowcaseRankItemTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
       <TextBlock Text="暂无已评分的影视"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DashboardEmptyLabel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardTopScreens.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel></Border>
      <Border x:Name="DashboardAuthorRanking" Grid.Row="2" Margin="0,12,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerBrush}"><StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="作者评分" Style="{StaticResource DashboardSectionHeading}"/><TextBlock Text="满分 5.0" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="12,4,0,0"/></StackPanel>
       <ItemsControl ItemsSource="{Binding DashboardTopAuthors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Author}" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ScoreLabel}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
     </Grid></Border>
     <Border x:Name="DashboardJournalSection" Grid.Column="2" Style="{StaticResource ReadingPanel}" Padding="16"><StackPanel>
      <TextBlock Text="最近记录" Style="{StaticResource DashboardSectionHeading}" Margin="0,0,0,8"/>
      <Border x:Name="DashboardTimelineEmptyState" Padding="0,16" Visibility="Collapsed"><TextBlock Text="完成记录会按日期显示在这里。" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/></Border>
      <ItemsControl x:Name="DashboardTimelineList" ItemsSource="{Binding DashboardTimelineDays}"><ItemsControl.ItemTemplate><DataTemplate>
       <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,2,0,0"><TextBlock Text="{Binding DateLabel}" FontSize="13" Foreground="{StaticResource MutedStrongBrush}"/><TextBlock Text="{Binding YearLabel}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
         <Button Tag="{Binding}" Click="DashboardWork_Open" Style="{StaticResource DashboardRowButton}" Padding="4,2" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}"><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ActionLabel}" Margin="0,2,0,0" FontSize="13" Height="18" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TimelineNote" Text="{Binding NotesExcerpt}" Margin="0,2,0,0" FontSize="13" LineHeight="18" MaxHeight="18" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedStrongBrush}"/></StackPanel></Button>
         <DataTemplate.Triggers><DataTrigger Binding="{Binding HasNotes}" Value="False"><Setter TargetName="TimelineNote" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

     </StackPanel></Border>
    </Grid>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
