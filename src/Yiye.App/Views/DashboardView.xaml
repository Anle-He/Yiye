<UserControl x:Class="Yiye.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:controls="clr-namespace:Yiye.Controls" SizeChanged="Dashboard_SizeChanged">
 <UserControl.Resources>
  <SolidColorBrush x:Key="DashboardScreenBrush" Color="#A47F57"/>
  <Style x:Key="RankingMeter" TargetType="ProgressBar">
   <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/><Setter Property="Height" Value="3"/>
   <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Background" Value="#DCE5E2"/>
   <Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="1.5"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1.5"/></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RankingPanel" TargetType="Border">
   <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14,12"/>
   <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Compact"><Setter Property="Padding" Value="10,9"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="DashboardRowButton" TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentSoftBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DashboardSectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
  <Style x:Key="DashboardEmptyLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,10,0,8"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <DataTemplate x:Key="RecentCoverTemplate">
   <Button x:Name="RecentAction" Tag="{Binding}" Click="DashboardWork_Open" Style="{StaticResource DashboardRowButton}" HorizontalAlignment="Center" Padding="3" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
    <StackPanel x:Name="RecentCardContent" Width="120">
     <Grid x:Name="RecentThumbnail" Height="170">
      <Border x:Name="RecentPlaceholder" Background="#DEE7E4" CornerRadius="2" Visibility="Collapsed">
       <Grid>
        <StackPanel Margin="12" VerticalAlignment="Center">
         <md:PackIcon x:Name="RecentKindIcon" Kind="BookOpenPageVariantOutline" Width="28" Height="28" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
         <TextBlock Text="{Binding Title}" Margin="0,12,0,0" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxHeight="60" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
        </StackPanel>
       </Grid>
      </Border>
      <Image x:Name="RecentCoverImage" Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=360}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
       <Image.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.13"/></Image.Effect>
      </Image>
     </Grid>
     <controls:BalancedTitleBlock x:Name="RecentTitle" Title="{Binding Title}" FontSize="15" FontWeight="Medium" Margin="0,9,0,0" Height="42" LineHeight="21" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
    </StackPanel>
   </Button>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Source, ElementName=RecentCoverImage}" Value="{x:Null}"><Setter TargetName="RecentPlaceholder" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="screen"><Setter TargetName="RecentKindIcon" Property="Kind" Value="MovieOpenOutline"/></DataTrigger>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Compact"><Setter TargetName="RecentCardContent" Property="Width" Value="90"/><Setter TargetName="RecentThumbnail" Property="Height" Value="120"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="ShowcaseRankItemTemplate">
   <Button x:Name="RankAction" Tag="{Binding}" Click="DashboardWork_Open" Style="{StaticResource DashboardRowButton}" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}" Padding="3,3" Margin="0,1">
    <Grid x:Name="RankItemLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="RankPosition" Text="{Binding PositionLabel}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
     <Grid x:Name="RankThumbnail" Grid.Column="1" Width="24" Height="34">
      <Border x:Name="RankPlaceholder" Background="#DEE7E4" CornerRadius="2" Visibility="Collapsed"><md:PackIcon x:Name="RankKindIcon" Kind="BookOpenPageVariantOutline" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <Image x:Name="RankCoverImage" Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=160}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     </Grid>
     <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
      <TextBlock x:Name="RankTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="15" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
      <TextBlock x:Name="RankAuthor" Text="{Binding Author}" ToolTip="{Binding Author}" TextTrimming="CharacterEllipsis" FontSize="13" Height="18" LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
     </StackPanel>
     <StackPanel Grid.Column="3" Width="36" VerticalAlignment="Center">
      <TextBlock x:Name="RankScore" Text="{Binding RankLabel}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
      <ProgressBar x:Name="RankMeter" Value="{Binding ScoreRatio, Mode=OneWay}" Style="{StaticResource RankingMeter}" Margin="0,3,0,0"/>
     </StackPanel>
    </Grid>
   </Button>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Source, ElementName=RankCoverImage}" Value="{x:Null}"><Setter TargetName="RankPlaceholder" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="screen"><Setter TargetName="RankKindIcon" Property="Kind" Value="MovieOpenOutline"/><Setter TargetName="RankScore" Property="Foreground" Value="{StaticResource ScoreBrush}"/><Setter TargetName="RankMeter" Property="Foreground" Value="{StaticResource DashboardScreenBrush}"/><Setter TargetName="RankMeter" Property="Background" Value="#E8E0D5"/><Setter TargetName="RankPlaceholder" Property="Background" Value="#ECE3D8"/></DataTrigger>
    <DataTrigger Binding="{Binding IsLead}" Value="True"><Setter TargetName="RankThumbnail" Property="Width" Value="42"/><Setter TargetName="RankThumbnail" Property="Height" Value="60"/><Setter TargetName="RankTitle" Property="FontWeight" Value="SemiBold"/><Setter TargetName="RankTitle" Property="TextWrapping" Value="Wrap"/><Setter TargetName="RankTitle" Property="MaxHeight" Value="40"/><Setter TargetName="RankAuthor" Property="Visibility" Value="Visible"/><Setter TargetName="RankScore" Property="FontSize" Value="24"/><Setter TargetName="RankAction" Property="Margin" Value="0,0,0,5"/><Setter TargetName="RankPosition" Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsLead}" Value="True"/><Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Compact"/></MultiDataTrigger.Conditions><Setter TargetName="RankThumbnail" Property="Width" Value="34"/><Setter TargetName="RankThumbnail" Property="Height" Value="50"/><Setter TargetName="RankTitle" Property="TextWrapping" Value="NoWrap"/><Setter TargetName="RankAction" Property="Margin" Value="0,0,0,2"/></MultiDataTrigger>
    <DataTrigger Binding="{Binding Author}" Value="{x:Null}"><Setter TargetName="RankAuthor" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding Author}" Value=""><Setter TargetName="RankAuthor" Property="Visibility" Value="Collapsed"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="AuthorCloudTemplate">
   <Border x:Name="AuthorCloudWord" Padding="3,1" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3" Background="Transparent" Focusable="True" KeyboardNavigation.TabIndex="{Binding Position}" AutomationProperties.Name="{Binding Summary}" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000" GotKeyboardFocus="AuthorWord_GotKeyboardFocus" LostKeyboardFocus="AuthorWord_LostKeyboardFocus" PreviewKeyDown="AuthorWord_PreviewKeyDown" IsVisibleChanged="AuthorWord_IsVisibleChanged">
    <Border.ToolTip><ToolTip Content="{Binding PlacementTarget.DataContext.Summary, RelativeSource={RelativeSource Self}}" Placement="Bottom"/></Border.ToolTip>
    <TextBlock x:Name="AuthorCloudLabel" Text="{Binding CloudLabel}" FontSize="{Binding FontSize}" FontWeight="Medium" Foreground="#426B60" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </Border>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Compact"><Setter TargetName="AuthorCloudLabel" Property="FontSize" Value="{Binding CompactFontSize}"/></DataTrigger>
    <DataTrigger Binding="{Binding IsVertical}" Value="True"><Setter TargetName="AuthorCloudLabel" Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter TargetName="AuthorCloudLabel" Property="LineHeight" Value="{Binding VerticalLineHeight}"/></DataTrigger>
    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsVertical}" Value="True"/><Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Compact"/></MultiDataTrigger.Conditions><Setter TargetName="AuthorCloudLabel" Property="LineHeight" Value="{Binding CompactVerticalLineHeight}"/></MultiDataTrigger>
    <DataTrigger Binding="{Binding Position}" Value="1"><Setter TargetName="AuthorCloudLabel" Property="FontWeight" Value="SemiBold"/><Setter TargetName="AuthorCloudLabel" Property="Foreground" Value="#234F4A"/></DataTrigger>
    <Trigger SourceName="AuthorCloudWord" Property="IsKeyboardFocused" Value="True"><Setter TargetName="AuthorCloudWord" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
    <Trigger SourceName="AuthorCloudWord" Property="IsMouseOver" Value="True"><Setter TargetName="AuthorCloudWord" Property="Background" Value="#CADDD4"/></Trigger>
   </DataTemplate.Triggers>
  </DataTemplate>
 </UserControl.Resources>
 <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource PageBrush}">
  <StackPanel x:Name="DashboardContent" Margin="28,12,28,20">
   <Border x:Name="DashboardHero" Padding="32,48">
    <StackPanel><md:PackIcon Kind="BookOpenPageVariantOutline" Width="48" Height="48" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="添加第一部作品" FontSize="26" FontWeight="SemiBold" Margin="0,24,0,0"/><TextBlock Text="记录读过的书、看过的影视，以及自己的评分和感想。" FontSize="15" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><Button Content="添加作品" Style="{StaticResource PrimaryButton}" Click="AddWork_Click" HorizontalAlignment="Left" Margin="0,24,0,0"/></StackPanel>
   </Border>
   <Grid x:Name="DashboardCollectionHeader" Margin="0,0,0,24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
    <Grid x:Name="DashboardBookMetric" Margin="0,0,24,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <md:PackIcon Kind="BookOpenPageVariantOutline" Width="29" Height="29" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
     <StackPanel Grid.Column="1"><TextBlock Text="读过" FontSize="15" Foreground="{StaticResource MutedBrush}"/>
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="DashboardBookCountText" Text="0" FontSize="48" FontWeight="SemiBold" LineHeight="56" LineStackingStrategy="BlockLineHeight"/><TextBlock Text="本书" FontSize="15" Margin="9,0,0,8" VerticalAlignment="Bottom"/></StackPanel>
     </StackPanel>
    </Grid>
    <Grid x:Name="DashboardScreenMetric" Grid.Column="1" Margin="0,0,24,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <md:PackIcon Kind="MovieOpenOutline" Width="29" Height="29" VerticalAlignment="Center" Foreground="{StaticResource DashboardScreenBrush}"/>
     <StackPanel Grid.Column="1"><TextBlock Text="看过" FontSize="15" Foreground="{StaticResource MutedBrush}"/>
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="DashboardScreenCountText" Text="0" FontSize="48" FontWeight="SemiBold" LineHeight="56" LineStackingStrategy="BlockLineHeight"/><TextBlock Text="部影视" FontSize="15" Margin="9,0,0,8" VerticalAlignment="Bottom"/></StackPanel>
     </StackPanel>
    </Grid>
    <StackPanel x:Name="DashboardStats" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
     <TextBlock Text="书影比例" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
     <Border Height="8" Background="{StaticResource TimelineBrush}" CornerRadius="4">
      <Grid x:Name="DashboardCompletionRatio" ClipToBounds="True" AutomationProperties.Name="已完成作品中的书影比例">
       <Grid.ColumnDefinitions><ColumnDefinition x:Name="BookRatioColumn" Width="0*"/><ColumnDefinition x:Name="ScreenRatioColumn" Width="0*"/></Grid.ColumnDefinitions>
       <Border x:Name="DashboardBookRatio" Background="{StaticResource AccentBrush}" CornerRadius="4,0,0,4"/>
       <Border x:Name="DashboardScreenRatio" Grid.Column="1" Background="{StaticResource DashboardScreenBrush}" CornerRadius="0,4,4,0"/>
      </Grid>
     </Border>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DashboardBookShareText" FontSize="13" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DashboardScreenShareText" Grid.Column="1" FontSize="13" Foreground="{StaticResource MutedBrush}"/></Grid>
    </StackPanel>
   </Grid>
   <StackPanel x:Name="DashboardShowcasePanel">
    <Grid x:Name="DashboardMainColumn">
     <Border x:Name="DashboardRecentSection" SizeChanged="DashboardRecentSection_SizeChanged"><StackPanel>
      <TextBlock x:Name="RecentHeading" Text="最近完成" Style="{StaticResource DashboardSectionHeading}" Margin="0,0,0,10"/>
      <Border x:Name="DashboardRecentEmptyState" Padding="0,24" Visibility="Collapsed">
       <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Bookshelf" Width="36" Height="36" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0"/><StackPanel><TextBlock Text="还没有完成记录" FontSize="16"/><TextBlock Text="打开作品，记下读完或看完的日期。" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></StackPanel>
      </Border>
      <ItemsControl x:Name="RecentWorkPicker" ItemsSource="{Binding DashboardRecentWorks}" ItemTemplate="{StaticResource RecentCoverTemplate}" AutomationProperties.Name="最近完成的作品"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
     </StackPanel></Border>
    </Grid>
    <Grid x:Name="DashboardColumns" Margin="0,24,0,0">
      <Border x:Name="DashboardSideColumn"><Grid x:Name="DashboardRankingColumns">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border x:Name="DashboardBookRanking" Style="{StaticResource RankingPanel}" Background="#F8FAF9"><StackPanel>
        <Grid x:Name="BookHeadingPanel" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="书籍评分" Style="{StaticResource DashboardSectionHeading}"/><TextBlock Grid.Column="1" Text="/ 3.9" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
       <ItemsControl ItemsSource="{Binding DashboardTopBooks}" ItemTemplate="{StaticResource ShowcaseRankItemTemplate}"/>
       <TextBlock Text="暂无书籍评分"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DashboardEmptyLabel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardTopBooks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel></Border>
       <Border x:Name="DashboardScreenRanking" Grid.Column="2" Style="{StaticResource RankingPanel}" Background="#FAF7F1"><StackPanel>
        <Grid x:Name="ScreenHeadingPanel" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="影视评分" Style="{StaticResource DashboardSectionHeading}"/><TextBlock Grid.Column="1" Text="/ 3.9" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
       <ItemsControl ItemsSource="{Binding DashboardTopScreens}" ItemTemplate="{StaticResource ShowcaseRankItemTemplate}"/>
       <TextBlock Text="暂无影视评分"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DashboardEmptyLabel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardTopScreens.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel></Border>
       <Border x:Name="DashboardAuthorRanking" Grid.Column="4" Style="{StaticResource RankingPanel}" Background="#E5EEEA"><StackPanel>
        <Grid x:Name="AuthorHeadingPanel" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="作者评分" Style="{StaticResource DashboardSectionHeading}"/><TextBlock x:Name="AuthorCloudCount" Grid.Column="1" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid>
        <ItemsControl x:Name="AuthorCloud" ItemsSource="{Binding DashboardTopAuthors}" ItemTemplate="{StaticResource AuthorCloudTemplate}" AutomationProperties.Name="作者评分词云" ClipToBounds="True">
         <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Height" Value="156"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Compact"><Setter Property="Height" Value="140"/></DataTrigger><DataTrigger Binding="{Binding DashboardTopAuthors.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:WordCloudPanel VisibleCountChanged="AuthorCloud_VisibleCountChanged"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
       <TextBlock Text="暂无作者评分"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource DashboardEmptyLabel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DashboardTopAuthors.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel></Border>
     </Grid></Border>
    </Grid>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
