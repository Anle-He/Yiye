<UserControl x:Class="Yiye.Views.WorkDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:Yiye.Models" xmlns:shelf="clr-namespace:Yiye.Controls" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DetailScoreBorderBrush" Color="#E4D7C3" />
    </UserControl.Resources>
    <Grid Margin="0,10,10,10" Background="{StaticResource PageBrush}" SizeChanged="Detail_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Margin="30,4,30,0" Padding="0,0,0,10" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Content="返回首页" Style="{StaticResource TextButton}" Click="Back_Click" ToolTip="返回上一页 · Alt+←" Padding="8,4" />
                <TextBlock x:Name="DetailPathText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" x:Name="DetailEmpty" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
            <md:PackIcon Kind="MovieOpenOutline" Width="32" Height="32" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="选择一部作品" Margin="0,18,0,0" FontSize="24" HorizontalAlignment="Center" />
            <TextBlock Text="在作品库中打开一本书或一部影视。" Margin="0,8,0,0" FontSize="16" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" x:Name="DetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="DetailBody" Margin="24,16,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CoverColumn" Width="300" />
                    <ColumnDefinition x:Name="CoverGap" Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="CoverPlate" Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource ReadingPanel}" Padding="20">
                    <StackPanel VerticalAlignment="Center">
                        <Button x:Name="DetailCoverButton" Width="160" Height="218" Style="{x:Null}" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="管理封面" AutomationProperties.Name="管理封面" Click="ManageCovers_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CoverFocus" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="CoverFocus" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox x:Name="CoverViewport" Width="156" Height="214">
                                <shelf:CoverStack x:Name="DetailCovers" Width="152" Height="214" />
                            </Viewbox>
                        </Button>
                        <Border x:Name="DetailHeroShell" BorderThickness="0" Background="Transparent" Margin="0,10,0,0">
                            <Border x:Name="HeroSurface" Background="Transparent">
                                <Grid x:Name="DetailHero">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel x:Name="HeroInformation">
                                        <StackPanel x:Name="HeroEyebrow" Margin="0,0,0,4">
                                            <TextBlock x:Name="DetailKickerText" Text="作品" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="DetailTitleText" FontSize="24" LineHeight="32" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        <TextBlock x:Name="DetailSubtitleText" Margin="0,6,0,0" FontSize="16" LineHeight="24" Foreground="{StaticResource MutedStrongBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                        <TextBlock x:Name="DetailAuthorText" Margin="0,6,0,0" FontSize="15" Foreground="{StaticResource MutedStrongBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                        <Border x:Name="HeroMeta" Margin="0,10,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="DetailMetaText" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel x:Name="HeroActions" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Left">
                                        <Button x:Name="PrimaryExperienceButton" Content="记一次完成" Style="{StaticResource PrimaryButton}" Click="PrimaryExperience_Click" Width="124" MinWidth="0" Height="36" Padding="14,0" Margin="0,0,8,0" />
                                        <Button x:Name="EditWorkButton" Style="{StaticResource QuietIconButton}" MinWidth="0" ToolTip="编辑资料" AutomationProperties.Name="编辑资料" Click="EditWork_Click" Margin="0,0,4,0">
                                            <md:PackIcon Kind="PencilOutline" Width="18" Height="18" />
                                        </Button>
                                        <Button x:Name="DeleteWorkButton" Style="{StaticResource QuietIconButton}" MinWidth="0" ToolTip="删除作品" AutomationProperties.Name="删除作品" Click="DeleteWork_Click">
                                            <md:PackIcon Kind="DeleteOutline" Width="18" Height="18" />
                                        </Button>
                                    </StackPanel>
                                    <Border x:Name="SummarySurface" Grid.Row="2" Margin="0,8,0,0" Padding="10,6" CornerRadius="10" Background="{StaticResource ScoreSoftBrush}" BorderBrush="{StaticResource DetailScoreBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="综合评分" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedStrongBrush}" />
                                            <TextBlock x:Name="DetailRankText" Grid.Column="1" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource ScoreBrush}"><Run x:Name="DetailRankValueRun" /><Run x:Name="DetailRankMaximumRun" FontSize="13" FontWeight="Normal" Foreground="{StaticResource MutedStrongBrush}" /></TextBlock>
                                            <TextBlock x:Name="DetailRatingCountText" Grid.Row="1" Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock x:Name="DetailCountText" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
                <Border x:Name="DetailRecordsPanel" Grid.Column="2" Style="{StaticResource ReadingPanel}" Padding="20" VerticalAlignment="Top">
                    <StackPanel x:Name="DetailContentColumn">
                        <Grid x:Name="HistoryHeader" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="HistoryEyebrow" Visibility="Collapsed" />
                                <TextBlock x:Name="HistoryTitle" Text="阅读与观看记录" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="HistoryCaptionText" Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                        <StackPanel x:Name="UnfinishedHistory" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock Text="待完成记录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding UnfinishedExperiences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,12" Margin="0,0,0,8" BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="2,0,0,0" Background="{StaticResource SurfaceSecondaryBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DateRangeLabel}" FontSize="13" Foreground="{StaticResource MutedStrongBrush}" />
                                                <TextBlock Text="{Binding Notes}" FontSize="16" LineHeight="26" TextWrapping="Wrap" Margin="0,7,0,8" />
                                                <Button Content="查看记录" Tag="{Binding}" Click="EditExperience_Click" Style="{StaticResource TextButton}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border x:Name="HistoryEmpty" Margin="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,22">
                            <StackPanel>
                                <TextBlock Text="还没有完成记录" FontSize="16" Foreground="{StaticResource MutedStrongBrush}" />
                                <TextBlock Text="读完或看完后，记下日期和感想。" Margin="0,7,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="HistoryList" ItemsSource="{Binding CompletedExperiences}" Margin="0" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="RecordSurface" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="RecordSurface" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="ArchiveCard" Background="{StaticResource SurfaceSecondaryBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="14" CornerRadius="12" Margin="0,0,0,10">
                                        <Grid x:Name="ArchiveLayout" DataContextChanged="ArchiveLayout_DataContextChanged" SizeChanged="ArchiveLayout_SizeChanged" Loaded="ArchiveLayout_Loaded" TextElement.FontFamily="Segoe UI Variable Text, Microsoft YaHei UI">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid x:Name="ArchiveTicket" Grid.RowSpan="2" VerticalAlignment="Top">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ArchiveNumberText" Grid.ColumnSpan="3" FontSize="13" Foreground="{StaticResource MutedBrush}"><Run Text="第 " /><Run Text="{Binding ArchiveNumberLabel, Mode=OneWay}" /><Run Text=" 次" /></TextBlock>
                                                <TextBlock x:Name="ArchiveDateText" Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding CompletionMonthDayLabel}" Margin="0,6,0,0" FontSize="24" Foreground="{StaticResource MutedStrongBrush}" VerticalAlignment="Center" />
                                                <StackPanel x:Name="ArchiveDateMetadata" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,3,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CompletionYearLabel}" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                                                    <TextBlock x:Name="ArchiveWeekdayText" Text="{Binding CompletionWeekdayLabel}" FontSize="13" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                                <Button x:Name="ArchiveEditButton" Grid.Row="3" Grid.ColumnSpan="3" Content="编辑记录" Tag="{Binding Experience}" Click="EditExperience_Click" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-8,6,0,0" Padding="8,4" FontSize="14" ToolTip="编辑这次记录" />
                                            </Grid>
                                            <Grid x:Name="ArchiveNotes" Grid.Column="2" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Notes}" FontSize="16" LineHeight="26" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasNotes}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="未写感想" FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <Grid x:Name="DimensionScores" Grid.Column="2" Grid.Row="1" Margin="0,14,0,0" MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Top" TextElement.FontFamily="Monotype Corsiva, Gabriola, Palatino Linotype" TextElement.FontWeight="Normal">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCompleteRating}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.Resources>
                                                    <Style x:Key="DimensionName" TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="25" />
                                                        <Setter Property="Foreground" Value="{StaticResource MutedStrongBrush}" />
                                                    </Style>
                                                    <Style x:Key="DimensionScore" TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="44" />
                                                        <Setter Property="Foreground" Value="{StaticResource ScoreBrush}" />
                                                        <Setter Property="Margin" Value="0,4,0,0" />
                                                    </Style>
                                                </Grid.Resources>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="16" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource DimensionName}" AutomationProperties.Name="Allure"><Run Text="All" FontSize="32" Foreground="{StaticResource AccentBrush}" /><Run Text="ure" /></TextBlock>
                                                    <TextBlock Style="{StaticResource DimensionScore}"><Run Text="{Binding Allure, Mode=OneWay}" /><Run Text="{Binding Source={x:Static models:RatingScale.AllureMaximum}, Mode=OneWay, StringFormat=' / {0}'}" FontSize="18" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource DimensionName}" AutomationProperties.Name="Immersion"><Run Text="Imm" FontSize="32" Foreground="{StaticResource AccentBrush}" /><Run Text="ersion" /></TextBlock>
                                                    <TextBlock Style="{StaticResource DimensionScore}"><Run Text="{Binding Immersion, Mode=OneWay}" /><Run Text="{Binding Source={x:Static models:RatingScale.DimensionMaximum}, Mode=OneWay, StringFormat=' / {0}'}" FontSize="18" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2">
                                                    <TextBlock Style="{StaticResource DimensionName}" AutomationProperties.Name="Rationality"><Run Text="Rat" FontSize="32" Foreground="{StaticResource AccentBrush}" /><Run Text="ionality" /></TextBlock>
                                                    <TextBlock Style="{StaticResource DimensionScore}"><Run Text="{Binding Rationality, Mode=OneWay}" /><Run Text="{Binding Source={x:Static models:RatingScale.DimensionMaximum}, Mode=OneWay, StringFormat=' / {0}'}" FontSize="18" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="2">
                                                    <TextBlock Style="{StaticResource DimensionName}" AutomationProperties.Name="Illumination"><Run Text="Ill" FontSize="32" Foreground="{StaticResource AccentBrush}" /><Run Text="umination" /></TextBlock>
                                                    <TextBlock Style="{StaticResource DimensionScore}"><Run Text="{Binding Illumination, Mode=OneWay}" /><Run Text="{Binding Source={x:Static models:RatingScale.DimensionMaximum}, Mode=OneWay, StringFormat=' / {0}'}" FontSize="18" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="IncompleteRating" Grid.Column="2" Grid.Row="1" Margin="0,14,0,0" Text="评分未填全" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCompleteRating}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasCompleteRating}" Value="True" />
                                                <Condition Binding="{Binding RatingTier}" Value="bronze" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ArchiveCard" Property="BorderBrush" Value="#DDC9B5" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasCompleteRating}" Value="True" />
                                                <Condition Binding="{Binding RatingTier}" Value="silver" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ArchiveCard" Property="BorderBrush" Value="#CBD3D7" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasCompleteRating}" Value="True" />
                                                <Condition Binding="{Binding RatingTier}" Value="gold" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="ArchiveCard" Property="BorderBrush" Value="#D9C48E" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
