<Window x:Class="Yiye.AddWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="添加作品" Height="650" Width="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app-icon.ico"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="14" TextOptions.TextFormattingMode="Display">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="添加作品" Style="{StaticResource DialogTitleStyle}" />
            <TextBlock x:Name="DescriptionText" Text="填写作品名称，其他资料可以稍后补充。" Style="{StaticResource DialogDescriptionStyle}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="WorkFormSection" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="类别" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="KindBox" SelectedIndex="0" Height="40" SelectionChanged="KindBox_SelectionChanged"
                              AutomationProperties.Name="作品类别">
                        <ComboBoxItem Tag="book" Content="书籍"/>
                        <ComboBoxItem Tag="screen" Content="影视"/>
                    </ComboBox>
                    <TextBlock Text="标题" Style="{StaticResource FieldLabelStyle}" Margin="0,22,0,7" />
                    <TextBox x:Name="TitleBox" MaxLength="200" Height="40" md:HintAssist.Hint="作品名称（必填）"
                                AutomationProperties.Name="作品标题" AutomationProperties.IsRequiredForForm="True"
                                TextChanged="TitleBox_TextChanged" />
                    <TextBlock x:Name="TitleError" Text="请输入作品名称" Foreground="#A33A32" Margin="2,6,0,0" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="副标题" Style="{StaticResource FieldLabelStyle}" Margin="0,22,0,7" />
                    <TextBox x:Name="SubtitleBox" MaxLength="300" Height="40" md:HintAssist.Hint="选填" AutomationProperties.Name="副标题" />
                    <StackPanel x:Name="AuthorPanel">
                        <TextBlock Text="作者" Style="{StaticResource FieldLabelStyle}" Margin="0,22,0,7" />
                        <TextBox x:Name="AuthorBox" MaxLength="200" Height="40" md:HintAssist.Hint="选填" AutomationProperties.Name="作者" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Border Grid.Row="2" Margin="0,24,0,0" Padding="0,20,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" MinWidth="76" Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="AddButton" Content="添加作品" Style="{StaticResource PrimaryButton}" MinWidth="96" Click="Save_Click" IsDefault="True" IsEnabled="False" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
