<ui:FluentWindow x:Class="Yiye.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:Yiye.Presentation" xmlns:behaviors="clr-namespace:Yiye.Behaviors" xmlns:shelf="clr-namespace:Yiye.Controls" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:Yiye.Views"
 Title="一页 Yiye · 书影音" Width="1280" Height="800" MinWidth="980" MinHeight="640"
 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
 WindowCornerPreference="Round" Icon="Assets/app-icon.ico" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
 FontSize="14" Foreground="{StaticResource TextBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <ui:TitleBar Title="一页 Yiye · 书影音" Icon="Assets/app-icon.ico"/>
 <Grid Grid.Row="1" Background="{StaticResource PageBrush}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="NavigationRail" Grid.Column="0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" Margin="0,10,0,10" Padding="18,24">
                <StackPanel><TextBlock Text="一页" FontFamily="SimSun" FontSize="28"/><TextBlock Text="YIYE" FontFamily="Georgia" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,30"/>
                    <ui:Button x:Name="HomeButton" Content="首页" Icon="{ui:SymbolIcon Home24}" Click="Home_Click" Appearance="Transparent" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <ui:Button x:Name="LibraryButton" Content="藏品" Icon="{ui:SymbolIcon Book24}" Click="Library_Click" Appearance="Transparent" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

 <Grid Grid.Column="1">
 <views:DashboardView x:Name="DashboardPage"/>
 <views:LibraryView x:Name="LibraryPage" Visibility="Collapsed"/>
 <views:WorkDetailView x:Name="DetailPage" Visibility="Collapsed"/>
 </Grid></Grid></Grid>
</ui:FluentWindow>
