<Window x:Class="Yiye.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:views="clr-namespace:Yiye.Views"
 Title="一页 Yiye · 书影" Width="1280" Height="800" MinWidth="980" MinHeight="640"
 WindowStartupLocation="CenterScreen" Style="{StaticResource MaterialDesignWindow}"
 Icon="Assets/app-icon.ico" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
 FontSize="15" Foreground="{StaticResource TextBrush}" Background="{StaticResource PageBrush}"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid Background="{StaticResource PageBrush}">
  <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <md:PackIcon Kind="BookOpenPageVariantOutline" Width="30" Height="30" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
  <Grid Grid.Column="1" Margin="28,0,28,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="一页" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Border Background="{StaticResource SurfaceBrush}" CornerRadius="22" Height="42" Width="320" HorizontalAlignment="Left" Margin="108,0,0,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
     <TextBox x:Name="GlobalSearchBox" KeyDown="GlobalSearch_KeyDown" FontSize="15" Padding="18,9,0,9" Background="Transparent" BorderThickness="0" AutomationProperties.Name="搜索作品或作者">
      <TextBox.Template><ControlTemplate TargetType="TextBox"><Grid><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/><TextBlock x:Name="Placeholder" Text="搜索作品或作者" Margin="{TemplateBinding Padding}" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></TextBox.Template>
     </TextBox>
     <Button Grid.Column="1" Style="{StaticResource QuietIconButton}" Click="GlobalSearch_Click" ToolTip="搜索（Enter）" AutomationProperties.Name="搜索"><md:PackIcon Kind="Magnify" Width="21" Height="21"/></Button>
    </Grid>
   </Border>
   <Button x:Name="GlobalAddWorkButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="42" Padding="24,8" Click="GlobalAddWork_Click" AutomationProperties.Name="添加作品">
    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/><TextBlock Text="添加作品" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
   </Button>
  </Grid>
  <Border x:Name="NavigationRail" Grid.Row="1" Background="{StaticResource LibraryPaneBrush}" CornerRadius="24" Margin="12,0,0,18" Padding="8,12,8,18">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Button x:Name="HomeButton" Click="Home_Click" Selector.IsSelected="True" Style="{StaticResource NavigationButton}" Margin="0,0,0,8" AutomationProperties.Name="首页">
      <StackPanel><md:PackIcon Kind="HomeOutline" Width="23" Height="23" HorizontalAlignment="Center"/><TextBlock Text="首页" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel>
     </Button>
     <Button x:Name="LibraryButton" Click="Library_Click" Style="{StaticResource NavigationButton}" AutomationProperties.Name="作品库">
      <StackPanel><md:PackIcon Kind="Bookshelf" Width="23" Height="23" HorizontalAlignment="Center"/><TextBlock Text="作品库" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel>
     </Button>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="书影" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Grid.Column="1"><views:DashboardView x:Name="DashboardPage"/><views:LibraryView x:Name="LibraryPage" Visibility="Collapsed"/><views:WorkDetailView x:Name="DetailPage" Visibility="Collapsed"/></Grid>
  <Canvas x:Name="CoverTransitionLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" Panel.ZIndex="10" ClipToBounds="True"/>
 </Grid>
</Window>
