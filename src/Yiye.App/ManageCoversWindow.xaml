<Window x:Class="Yiye.ManageCoversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="管理封面" Width="900" Height="680" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app-icon.ico"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="14" TextOptions.TextFormattingMode="Display" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid x:Name="GalleryBody" Margin="32">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="管理封面" Style="{StaticResource DialogTitleStyle}" />
                    <TextBlock x:Name="CoverCountText" Style="{StaticResource DialogDescriptionStyle}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                        Content="添加图片" Click="AddCovers_Click" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,28,0,0">
                <Border x:Name="EmptyState" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="32">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <md:PackIcon Kind="ImageMultipleOutline" Width="36" Height="36" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="还没有封面" Margin="0,20,0,0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="选择本地图片，可一次添加多张。" Margin="0,8,0,22" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                        <Button Content="选择图片" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="AddCovers_Click" />
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="CoverScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,8">
                    <ItemsControl ItemsSource="{Binding Covers}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="198" ItemHeight="316" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="CoverTile" Width="182" Height="300" Margin="0,0,16,16">
                                    <Border x:Name="CoverFrame" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Button Tag="{Binding}" Click="PreviewCover_Click" Style="{x:Null}" Background="{StaticResource SurfaceSecondaryBrush}"
                                                    BorderThickness="0" Padding="4" Cursor="Hand" ToolTip="查看大图" AutomationProperties.Name="查看封面大图">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="PreviewSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3"
                                                                BorderBrush="Transparent" BorderThickness="2">
                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PreviewSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PreviewSurface" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Image Source="{Binding FilePath, Converter={StaticResource CoverImageConverter}, ConverterParameter=360}" Stretch="Uniform" />
                                            </Button>
                                            <Grid Grid.Row="1" Margin="2,12,2,10">
                                                <TextBlock Text="{Binding PositionLabel}" FontSize="13" Foreground="{StaticResource MutedStrongBrush}" VerticalAlignment="Center" />
                                                <Border x:Name="PrimaryBadge" HorizontalAlignment="Right" Padding="6,2" CornerRadius="3"
                                                        Background="{StaticResource AccentSoftBrush}" Visibility="Collapsed">
                                                    <TextBlock Text="主封面" Foreground="{StaticResource AccentStrongBrush}" FontSize="13" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Row="2">
                                                <Button Content="设为主封面" Height="30" MinHeight="0" Tag="{Binding}" Click="SetPrimary_Click" HorizontalAlignment="Stretch">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Grid Margin="0,6,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button ToolTip="向前移动" AutomationProperties.Name="封面向前移动"
                                                                Width="32" Height="30" MinWidth="0" MinHeight="0" Padding="0" Tag="{Binding}" Click="MoveEarlier_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                                                    <Style.Triggers><DataTrigger Binding="{Binding DataContext.Covers.Count, RelativeSource={RelativeSource AncestorType=Window}}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <md:PackIcon Kind="ArrowLeft" Width="18" Height="18"/>
                                                        </Button>
                                                        <Button ToolTip="向后移动" AutomationProperties.Name="封面向后移动"
                                                                Width="32" Height="30" MinWidth="0" MinHeight="0" Padding="0" Tag="{Binding}" Click="MoveLater_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                                                                    <Style.Triggers><DataTrigger Binding="{Binding DataContext.Covers.Count, RelativeSource={RelativeSource AncestorType=Window}}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <md:PackIcon Kind="ArrowRight" Width="18" Height="18"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <Button HorizontalAlignment="Right" ToolTip="删除封面" AutomationProperties.Name="删除封面"
                                                            Width="32" Height="30" MinWidth="0" MinHeight="0" Padding="0" Style="{StaticResource TextButton}" Foreground="{StaticResource MutedBrush}" Tag="{Binding}" Click="DeleteCover_Click">
                                                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                        <Setter TargetName="CoverFrame" Property="BorderBrush" Value="{StaticResource AccentLineBrush}" />
                                        <Setter TargetName="PrimaryBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Grid x:Name="PreviewOverlay" Background="#B8151A17" Visibility="Collapsed" MouseLeftButtonUp="ClosePreview_Click" KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="500" MaxHeight="590" Padding="24" Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource FloatShadow}" MouseLeftButtonUp="PreviewPanel_Click">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="封面预览" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock x:Name="PreviewCaptionText" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Button x:Name="ClosePreviewButton" Grid.Column="1" VerticalAlignment="Top" Width="36" Height="36" MinWidth="0" MinHeight="0" Padding="0"
                                ToolTip="关闭预览（Esc）" AutomationProperties.Name="关闭预览" Style="{StaticResource TextButton}" Click="ClosePreview_Click">
                            <md:PackIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,20,0,0" MinHeight="320" Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="3" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
