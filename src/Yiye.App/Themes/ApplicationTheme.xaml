<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Yiye.Converters" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

            <ResourceDictionary.MergedDictionaries>
                <md:CustomColorTheme BaseTheme="Light" PrimaryColor="#356D67" SecondaryColor="#687F7D" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PageBrush" Color="#F0F1F5" />
            <SolidColorBrush x:Key="LibraryPaneBrush" Color="#E1E7E9" />
            <SolidColorBrush x:Key="DetailPaneBrush" Color="#F0F1F5" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#F1F4F3" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EAF1EF" />
            <SolidColorBrush x:Key="TextBrush" Color="#2E3738" />
            <SolidColorBrush x:Key="MutedBrush" Color="#626E72" />
            <SolidColorBrush x:Key="MutedStrongBrush" Color="#556267" />
            <SolidColorBrush x:Key="AccentBrush" Color="#356D67" />
            <SolidColorBrush x:Key="AccentStrongBrush" Color="#234F4A" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#D5E8E3" />
            <SolidColorBrush x:Key="AccentLineBrush" Color="#ADCBC5" />
            <SolidColorBrush x:Key="WarmBrush" Color="#606466" />
            <SolidColorBrush x:Key="WarmSoftBrush" Color="#F2F3F4" />
            <SolidColorBrush x:Key="ActiveSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HeroLineBrush" Color="#E5E7E8" />
            <SolidColorBrush x:Key="TimelineBrush" Color="#DEE0E1" />
            <SolidColorBrush x:Key="ScoreBrush" Color="#8B643D" />
            <SolidColorBrush x:Key="ScoreSoftBrush" Color="#F7F0E5" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#F6EEE0" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#F8E9E7" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E2E7E6" />

            <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.09" />
            <DropShadowEffect x:Key="HeroShadow" Color="#000000" BlurRadius="28" ShadowDepth="7" Opacity="0.13" />
            <DropShadowEffect x:Key="FloatShadow" Color="#000000" BlurRadius="36" ShadowDepth="10" Opacity="0.15" />

            <CornerRadius x:Key="CardRadius">20</CornerRadius>
            <Thickness x:Key="PagePadding">28</Thickness>
            <Thickness x:Key="CardPadding">18</Thickness>
            <converters:CoverImageConverter x:Key="CoverImageConverter" />

            <Style x:Key="ReadingPanel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="BorderBrush" Value="#60FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="md:ButtonAssist.CornerRadius" Value="21" />
                <Setter Property="md:ElevationAssist.Elevation" Value="Dp0" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="md:ButtonAssist.CornerRadius" Value="6" />
            </Style>
            <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="{StaticResource MutedStrongBrush}" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="md:ButtonAssist.CornerRadius" Value="6" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />
            <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="6" />
                <Setter Property="md:HintAssist.IsFloating" Value="False" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="6" />
            </Style>
            <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="6" />
            </Style>

            <Style x:Key="NavigationButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="72" />
                <Setter Property="Padding" Value="6,10" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavigationSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="18" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavigationSurface" Property="Opacity" Value="0.8" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavigationSurface" Property="Opacity" Value="0.45" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavigationSurface" Property="BorderBrush" Value="{StaticResource MutedBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" /></Trigger>
                    <Trigger Property="Selector.IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="62" />
                <Setter Property="Padding" Value="14,5" />
                <Setter Property="md:ButtonAssist.CornerRadius" Value="17" />
                <Style.Triggers>
                    <Trigger Property="Selector.IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DialogEyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>
            <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="FontSize" Value="27" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style x:Key="DialogDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,7,0,0" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,7" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedStrongBrush}" />
            </Style>
            <Style x:Key="FieldHintStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="2,7,0,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FormSectionStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="DialogActionBarStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,18,0,0" />
                <Setter Property="Padding" Value="0,16,0,0" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>


        <Style x:Key="HeaderAddWorkButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="QuietIconButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SectionEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="ShowcaseHeading" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DashboardScore" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia, Palatino Linotype"/>
            <Setter Property="FontStyle" Value="Normal"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource ScoreBrush}"/>
        </Style>
        <Style x:Key="WidgetShell" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <DrawingBrush x:Key="DotPatternBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"
                      Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#70FFFFFF">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="3,3" RadiusX="1.1" RadiusY="1.1" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DataTemplate x:Key="WorkRatingMarkTemplate">
            <Grid Width="90" Height="44" ToolTip="{Binding AggregateRatingMarkLabel}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAggregateRank}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Margin="1,0,1,0">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="20" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path x:Name="RatingStarPrimary" Width="13" Height="13" Stretch="Uniform"
                                  Fill="#A95F32" Stroke="#6F3A21" StrokeThickness="0.6"
                                  Data="M 7,0 L 8.7,5.3 L 14,7 L 8.7,8.7 L 7,14 L 5.3,8.7 L 0,7 L 5.3,5.3 Z"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Path x:Name="RatingStarSecondary" Width="8" Height="8" Stretch="Uniform"
                                  Fill="#C9CED2" Stroke="#6F777D" StrokeThickness="0.65" Visibility="Collapsed"
                                  Data="M 7,0 L 8.7,5.3 L 14,7 L 8.7,8.7 L 7,14 L 5.3,8.7 L 0,7 L 5.3,5.3 Z"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <Path x:Name="RatingStarTertiary" Width="6" Height="6" Stretch="Uniform"
                                  Fill="#E0B84F" Stroke="#8A621A" StrokeThickness="0.7" Visibility="Collapsed"
                                  Data="M 7,0 L 8.7,5.3 L 14,7 L 8.7,8.7 L 7,14 L 5.3,8.7 L 0,7 L 5.3,5.3 Z"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,0" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RatingValue" Text="{Binding AggregateRankValueLabel}" FontSize="17"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="RatingMaximum" Text="{Binding AggregateRankMaximumLabel}" Margin="3,4,0,0"
                                           FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="RatingRule" Grid.Row="1" Width="70" Height="1" HorizontalAlignment="Left" Background="{StaticResource DividerBrush}" />
                </Grid>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding AggregateScoreTier}" Value="silver">
                        <Setter TargetName="RatingStarPrimary" Property="Fill" Value="#C9CED2" />
                        <Setter TargetName="RatingStarPrimary" Property="Stroke" Value="#6F777D" />
                        <Setter TargetName="RatingStarSecondary" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AggregateScoreTier}" Value="gold">
                        <Setter TargetName="RatingStarPrimary" Property="Fill" Value="#E0B84F" />
                        <Setter TargetName="RatingStarPrimary" Property="Stroke" Value="#8A621A" />
                        <Setter TargetName="RatingStarSecondary" Property="Fill" Value="#E0B84F" />
                        <Setter TargetName="RatingStarSecondary" Property="Stroke" Value="#8A621A" />
                        <Setter TargetName="RatingStarSecondary" Property="Visibility" Value="Visible" />
                        <Setter TargetName="RatingStarTertiary" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ShelfWorkTemplate">
            <StackPanel Width="100" HorizontalAlignment="Left">
                <Grid Width="100" Height="142">
                    <Border Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source, ElementName=ShelfCover}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding KindGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="32" Foreground="{StaticResource MutedBrush}" />
                    </Border>
                    <Image x:Name="ShelfCover" Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=400}"
                           Width="100" Height="142" Stretch="Uniform">
                        <Image.Effect><DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.18" /></Image.Effect>
                    </Image>
                    <Border x:Name="CoverRatingBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,5,5" Padding="6,2" CornerRadius="3" Background="#F2FFFFFF"
                            BorderBrush="#60FFFFFF" BorderThickness="1" ToolTip="{Binding AggregateRatingMarkLabel}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAggregateRank}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CoverRatingStar" Text="★" Foreground="#A95F32" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding AggregateRankValueLabel}" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Normal" Foreground="{StaticResource TextBrush}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Height="22" LineHeight="22" LineStackingStrategy="BlockLineHeight"
                           ToolTip="{Binding Title}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Author}" FontSize="13" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Author}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding Author}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding AggregateScoreTier}" Value="gold"><Setter TargetName="CoverRatingStar" Property="Foreground" Value="#B88520" /></DataTrigger>
                <DataTrigger Binding="{Binding AggregateScoreTier}" Value="silver"><Setter TargetName="CoverRatingStar" Property="Foreground" Value="#78848C" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

</ResourceDictionary>
