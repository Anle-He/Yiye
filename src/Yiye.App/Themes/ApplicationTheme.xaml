<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Yiye.Converters" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PageBrush" Color="#E9EEE9" />
            <SolidColorBrush x:Key="LibraryPaneBrush" Color="#F8F8F5" />
            <SolidColorBrush x:Key="DetailPaneBrush" Color="#F3F5F1" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#E7ECE7" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FCFDFB" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F5F0" />
            <SolidColorBrush x:Key="TextBrush" Color="#18221C" />
            <SolidColorBrush x:Key="MutedBrush" Color="#68736C" />
            <SolidColorBrush x:Key="MutedStrongBrush" Color="#445149" />
            <SolidColorBrush x:Key="AccentBrush" Color="#1F6248" />
            <SolidColorBrush x:Key="AccentStrongBrush" Color="#174936" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCECE3" />
            <SolidColorBrush x:Key="AccentLineBrush" Color="#ACC8B7" />
            <SolidColorBrush x:Key="WarmBrush" Color="#C98732" />
            <SolidColorBrush x:Key="WarmSoftBrush" Color="#F6E8CE" />
            <SolidColorBrush x:Key="ActiveSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HeroLineBrush" Color="#DADDD7" />
            <SolidColorBrush x:Key="TimelineBrush" Color="#CFD9D2" />
            <SolidColorBrush x:Key="ScoreBrush" Color="#A66D19" />
            <SolidColorBrush x:Key="ScoreSoftBrush" Color="#F7F0E5" />
            <SolidColorBrush x:Key="WarningSoftBrush" Color="#F6EEE0" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#F8E9E7" />
            <SolidColorBrush x:Key="DividerBrush" Color="#D6DED7" />

            <DropShadowEffect x:Key="CardShadow" Color="#193627" BlurRadius="18" ShadowDepth="3" Opacity="0.09" />
            <DropShadowEffect x:Key="HeroShadow" Color="#193627" BlurRadius="28" ShadowDepth="7" Opacity="0.13" />
            <DropShadowEffect x:Key="FloatShadow" Color="#173125" BlurRadius="36" ShadowDepth="10" Opacity="0.15" />

            <CornerRadius x:Key="CardRadius">12</CornerRadius>
            <Thickness x:Key="PagePadding">28</Thickness>
            <Thickness x:Key="CardPadding">18</Thickness>
            <converters:CoverImageConverter x:Key="CoverImageConverter" />

            <Style x:Key="DialogEyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>
            <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="FontSize" Value="27" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style x:Key="DialogDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,7,0,0" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,7" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedStrongBrush}" />
            </Style>
            <Style x:Key="FieldHintStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="2,7,0,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FormSectionStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="DialogActionBarStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,18,0,0" />
                <Setter Property="Padding" Value="18,14" />
                <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>


        <Style x:Key="HeaderAddWorkButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Primary"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="QuietIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SectionEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="ShowcaseHeading" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DashboardScore" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia, Palatino Linotype"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource ScoreBrush}"/>
        </Style>
        <Style x:Key="WidgetShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <DrawingBrush x:Key="DotPatternBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"
                      Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#70FFFFFF">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="3,3" RadiusX="1.1" RadiusY="1.1" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DataTemplate x:Key="WorkRatingMarkTemplate">
            <Grid Width="74" Height="44" ToolTip="{Binding AggregateRatingMarkLabel}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAggregateRank}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Margin="1,0,1,0">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="20" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path x:Name="RatingStarPrimary" Width="13" Height="13" Stretch="Uniform"
                                  Fill="#A95F32" Stroke="#6F3A21" StrokeThickness="0.6"
                                  Data="M 7,0 L 8.7,5.3 L 14,7 L 8.7,8.7 L 7,14 L 5.3,8.7 L 0,7 L 5.3,5.3 Z"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Path x:Name="RatingStarSecondary" Width="8" Height="8" Stretch="Uniform"
                                  Fill="#C9CED2" Stroke="#6F777D" StrokeThickness="0.65" Visibility="Collapsed"
                                  Data="M 7,0 L 8.7,5.3 L 14,7 L 8.7,8.7 L 7,14 L 5.3,8.7 L 0,7 L 5.3,5.3 Z"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <Path x:Name="RatingStarTertiary" Width="6" Height="6" Stretch="Uniform"
                                  Fill="#E0B84F" Stroke="#8A621A" StrokeThickness="0.7" Visibility="Collapsed"
                                  Data="M 7,0 L 8.7,5.3 L 14,7 L 8.7,8.7 L 7,14 L 5.3,8.7 L 0,7 L 5.3,5.3 Z"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,0" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="RANK" FontSize="7.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,-1,0,0">
                                <TextBlock x:Name="RatingValue" Text="{Binding AggregateRankValueLabel}" FontSize="17"
                                           FontWeight="SemiBold" Foreground="#2F664B" />
                                <TextBlock x:Name="RatingMaximum" Text="{Binding AggregateRankMaximumLabel}" Margin="3,7,0,0"
                                           FontSize="9" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="RatingRule" Grid.Row="1" Width="70" Height="3" CornerRadius="2" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#35684E" Offset="0" />
                                <GradientStop Color="#C6994A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding AggregateScoreTier}" Value="silver">
                        <Setter TargetName="RatingStarPrimary" Property="Fill" Value="#C9CED2" />
                        <Setter TargetName="RatingStarPrimary" Property="Stroke" Value="#6F777D" />
                        <Setter TargetName="RatingStarSecondary" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding AggregateScoreTier}" Value="gold">
                        <Setter TargetName="RatingStarPrimary" Property="Fill" Value="#E0B84F" />
                        <Setter TargetName="RatingStarPrimary" Property="Stroke" Value="#8A621A" />
                        <Setter TargetName="RatingStarSecondary" Property="Fill" Value="#E0B84F" />
                        <Setter TargetName="RatingStarSecondary" Property="Stroke" Value="#8A621A" />
                        <Setter TargetName="RatingStarSecondary" Property="Visibility" Value="Visible" />
                        <Setter TargetName="RatingStarTertiary" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
        </DataTemplate>

                            <DataTemplate x:Key="ShelfWorkTemplate">
                                <StackPanel>
                                    <Grid Height="144" HorizontalAlignment="Center" MinWidth="90">
                                        <TextBlock Text="{Binding KindGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="28" Foreground="{StaticResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrimaryCoverPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding PrimaryCoverPath}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image x:Name="ShelfCover" Source="{Binding PrimaryCoverPath, Converter={StaticResource CoverImageConverter}, ConverterParameter=300}" Stretch="Uniform" MaxHeight="144"/>
                                        <Border x:Name="CoverRatingBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,4,5" Padding="6,2" CornerRadius="4" Background="#F5FFFCF3"
                                                BorderBrush="#40FFFFFF" BorderThickness="1" ToolTip="{Binding AggregateRatingMarkLabel}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAggregateRank}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="CoverRatingStar" Text="★" Foreground="#A95F32" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding AggregateRankValueLabel}" Foreground="#243C31" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Author}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Author}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Author}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding AggregateScoreTier}" Value="gold"><Setter TargetName="CoverRatingStar" Property="Foreground" Value="#B88520"/></DataTrigger>
                                    <DataTrigger Binding="{Binding AggregateScoreTier}" Value="silver"><Setter TargetName="CoverRatingStar" Property="Foreground" Value="#78848C"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>

</ResourceDictionary>
